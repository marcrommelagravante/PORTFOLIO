# Optional: Server-side GitHub Personal Access Token (fine-grained, read-only public data)
# Used to fetch live GitHub contribution heatmap data via the GitHub GraphQL API.
# If omitted, the site falls back cleanly to a public contribution summary or profile link.
GITHUB_TOKEN=

# Optional: Contact form delivery configuration (server-side only)
# Until both are configured, the contact form clearly indicates it is in template/placeholder mode.
CONTACT_PROVIDER_API_KEY=
CONTACT_TO_EMAIL=

# Optional: Public canonical site URL once deployed to a production domain
# Example: https://example.com
NEXT_PUBLIC_SITE_URL=
